# Backend Environment Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# JWT Secret for authentication tokens (use a long, secure random string in production)
JWT_SECRET=change_this_to_a_long_random_secret

# AI Service endpoint (Local: http://localhost:5001/analyze | Production: https://complaint-system-ai.onrender.com/analyze)
AI_SERVICE_URL=http://localhost:5001/analyze

# Complaints with AI confidence below this threshold are routed to manual admin review
AI_MIN_CONFIDENCE=0.30

# CORS Allowed Origins (comma-separated list, or * for all)
CORS_ORIGIN=https://complaint-system-2.vercel.app,https://complaint-system-2-182mdexw1-sameel2.vercel.app,https://complaint-system-2-sameel2.vercel.app,http://localhost:4000

# ---- Persistent Storage (Render Persistent Disk / Custom Paths) ----
# DATA_DIR=/var/data
# DB_PATH=/var/data/complaint_system.db
# UPLOADS_DIR=/var/data/uploads

# ---- E-mail (Optional SMTP settings) --------------------------------
# Leave SMTP_HOST blank to write notification logs to backend/outbox.log (demo mode)
# Gmail example (requires 2-Step Verification + an App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=your_16_char_app_password
#   MAIL_FROM="Society Complaint Desk <yourname@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
