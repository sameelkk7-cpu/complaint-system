{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://complaint-system-backend.onrender.com/api/$1"
    },
    {
      "source": "/css/(.*)",
      "destination": "/complaint-system/frontend/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/complaint-system/frontend/js/$1"
    },
    {
      "source": "/",
      "destination": "/complaint-system/frontend/index.html"
    },
    {
      "source": "/(.*)\\.html",
      "destination": "/complaint-system/frontend/$1.html"
    },
    {
      "source": "/(.*)",
      "destination": "/complaint-system/frontend/$1"
    }
  ]
}
