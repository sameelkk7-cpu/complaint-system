{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://complaint-system-backend-gtrc.onrender.com/api/$1"
    },
    {
      "source": "/css/(.*)",
      "destination": "/complaint-system/frontend/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/complaint-system/frontend/js/$1"
    },
    {
      "source": "/",
      "destination": "/complaint-system/frontend/index.html"
    },
    {
      "source": "/(.*)\\.html",
      "destination": "/complaint-system/frontend/$1.html"
    },
    {
      "source": "/(.*)",
      "destination": "/complaint-system/frontend/$1"
    }
  ]
}
